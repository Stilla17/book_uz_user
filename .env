# =========================================
# Frontend Environment Variables
# =========================================

# Main backend API base URL
# Example local: http://localhost:5000/api/v1
# Example prod:  https://api.bookuz.uz/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_API_URL=https://dev.book.uz/api/v1
NEXT_PUBLIC_API_BASE_URL=https://backend.book.uz/user-api/
# Enable bundle analyzer in Next.js build
# true | false
BUNDLE_ANALYZER_ENABLED=false

CLICK_RETURN_URL=https://dev.book.uz/payment/click/verify
# CLICK_RETURN_URL=https://strict-finer-daily.ngrok-free.dev/api/payment/click/verify
