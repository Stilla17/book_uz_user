":"In Search of the Wisdom of Our Ancestors is an educational work by Uzbek poet Eshqobil Shukur dedicated to the richness of the Uzbek language and the nation's cultural heritage. The book explores traditional expressions, proverbs, forgotten words, and their meanings, showing how language preserves the wisdom, history, and identity of a people. It is an insightful read for anyone interested in linguistics, folklore, and the cultural legacy of Uzbekistan."},"price":44000,"discountPrice":0,"image":"https://res.cloudinary.com/dd9xb0bqw/image/upload/v1786017200/bookstore/products/1786017199925-ChatGPT_Image_Aug_6__2026__04_52_31_PM.jpg","stock":171,"barcode":"9789910506185","year":2026,"cover":"softcover","numberOfPage":549,"category":"69fc6b8d025ac962dbb53662","categories":["69fc6b8d025ac962dbb53662"],"subCategoryId":"6a30e66d7529a5a534e473a9","subCategoryIds":["6a30e66d7529a5a534e473a9"],"author":[{"_id":"6a7472f622d8389d631a78ca","name":"Eshqobil Shukur","slug":"eshqobil-shukur"}],"publisher":"69fc83fa584037138230e62c","contentLanguage":"latin","language":"uz","isTop":false,"isDiscount":false,"ratingAvg":0,"ratingCount":0,"views":101,"isActive":true,"tegs":["ilmiy asar"],"branchStocks":[{"storeId":"14363808-eeb9-11ee-0a80-0e6b0024f833","storeName":"0 Book.uz sklad","quantity":46,"reserve":0,"available":46,"syncedAt":"2026-09-21T07:03:27.576Z","_id":"6ab0d70149cfbe2ade776b6c"},{"storeId":"8cac779b-ab52-11ec-0a80-09ec0007a15e","storeName":"1 Toshkent - Qatortol - bosh do'kon","quantity":9,"reserve":0,"available":9,"syncedAt":"2026-09-21T07:03:27.576Z","_id":"6ab0d70149cfbe2ade776b6d"},{"storeId":"9a503767-453b-11f0-0a80-0f9d0033e459","storeName":"2 Toshkent - Chorsu filial","quantity":17,"reserve":0,"available":17,"syncedAt":"2026-09-21T07:03:27.576Z","_id":"6ab0d70149cfbe2ade776b6e"},{"storeId":"0664e7c5-f232-11ec-0a80-09850011c255","storeName":"5 Navoiy filial","quantity":42,"reserve":0,"available":42,"syncedAt":"2026-09-21T07:03:27.576Z","_id":"6ab0d70149cfbe2ade7